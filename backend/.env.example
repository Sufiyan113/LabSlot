# ============================================================
# LabSlot Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/labslot?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/labslot?retryWrites=true&w=majority

# JWT (used in Phase 4 — Authentication)
# Generate a long random string (at least 32 characters)
JWT_SECRET=change_this_to_a_long_random_secret_key_in_production
JWT_EXPIRE=7d

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173
